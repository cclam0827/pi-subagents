{
  "name": "pi-subagents",
  "version": "0.1.0",
  "description": "Interactive, provider-neutral subagents for Pi with RPC lifecycles and a focusable agent panel.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "agents",
    "orchestration"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
